{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mixed-pilot normalized rubrics",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "max_score",
    "pass_threshold",
    "verification_level",
    "criteria"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "task_id": {
      "type": "string"
    },
    "max_score": {
      "const": 100
    },
    "pass_threshold": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "verification_level": {
      "type": "string"
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "description",
          "points",
          "method"
        ]
      }
    }
  }
}
